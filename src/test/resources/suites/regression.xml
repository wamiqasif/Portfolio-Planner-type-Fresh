<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Tests tagged "regression" - every positive/negative/edge-case/data-driven
    test across every module, but not necessarily every ad-hoc exploratory
    one. Intended for nightly or pre-release CI stages rather than every PR.
    Run with:
        mvn test -DsuiteXmlFile=src/test/resources/suites/regression.xml
-->
<suite name="APIAutomationRegressionSuite" parallel="classes" thread-count="5" verbose="1">

    <listeners>
        <listener class-name="com.org.apiautomation.listeners.TestLifecycleListener"/>
        <listener class-name="com.org.apiautomation.listeners.RetryAnnotationTransformer"/>
    </listeners>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.org.apitests.authentication.*"/>
            <package name="com.org.apitests.users.*"/>
            <package name="com.org.apitests.portfolio.*"/>
            <package name="com.org.apitests.funds.*"/>
            <package name="com.org.apitests.stocks.*"/>
            <package name="com.org.apitests.transactions.*"/>
            <package name="com.org.apitests.notifications.*"/>
            <package name="com.org.apitests.common.*"/>
            <package name="com.org.apitests.hub.*"/>
        </packages>
    </test>

</suite>
