{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hub Product (a menu's per-product variant - deliberately narrower than Menu: no id/icon/action_hint)",
  "type": "object",
  "required": ["title", "url", "is_ext_url"],
  "properties": {
    "title": { "type": "string" },
    "url": { "type": "string" },
    "download_url": { "type": ["string", "null"] },
    "is_ext_url": { "type": "boolean" },
    "component_code": { "type": ["string", "null"] }
  }
}
